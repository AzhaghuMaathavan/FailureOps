
# ============================================================
# COLLEGE AGENTIC RAG - ENVIRONMENT CONFIGURATION
# ============================================================

# ============================================================
# NVIDIA AI
# ============================================================

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# General NVIDIA API key
# Use this if multiple services share the same key.
NVIDIA_API_KEY=nvapi-your_api_key_here

# Separate keys can be used for independent rate-limit management.
NVIDIA_PARSE_API_KEY=nvapi-your_parse_key_here
NVIDIA_EMBED_API_KEY=nvapi-your_embed_key_here
NVIDIA_RERANK_API_KEY=nvapi-your_rerank_key_here
# Multi-Key Rotation for LLM Chat/Completions
NVIDIA_LLM_API_KEY_1=nvapi-your_api_key_here
NVIDIA_LLM_API_KEY_2=nvapi-your_api_key_here


# ============================================================
# NVIDIA MODELS
# ============================================================

# Search Settings
HYBRID_SEARCH_ENABLED=true
HYBRID_VECTOR_TOP_K=15
HYBRID_BM25_TOP_K=15
HYBRID_RRF_K=60

# Performance / Demo
DEMO_MODE=false
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_COMPRESSION_MAX_CHARS=1200
CONTEXT_COMPRESSION_MIN_CHARS=500

# Document parsing / layout understanding
NVIDIA_PARSE_MODEL=nvidia/nemotron-parse

# Text embeddings
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# Reranking
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
# Final grounded answer generation
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b


# ============================================================
# DATABASE - POSTGRESQL + PGVECTOR
# ============================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_rag

# PostgreSQL runs inside Docker.
# Host port: 5432
# Container port: 5432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/agentic_rag


# ============================================================
# APPLICATION
# ============================================================

APP_NAME=College Agentic RAG
APP_ENV=development

HOST=127.0.0.1
PORT=8000


# ============================================================
# RETRIEVAL
# ============================================================

# Number of candidates retrieved before reranking
TOP_K=10

# Number of candidates retained after reranking
RERANK_TOP_K=5

# Minimum similarity threshold
SIMILARITY_THRESHOLD=0.5


# ============================================================
# AGENT
# ============================================================

# Maximum number of agent retrieval/reasoning iterations
MAX_AGENT_STEPS=4


# ============================================================
# FILE UPLOAD
# ============================================================

# Maximum uploaded file size in bytes
# 10 MB
MAX_FILE_SIZE=10485760


# ============================================================
# SECURITY
# ============================================================

# Change this in production.
JWT_SECRET=change_this_secret_in_production

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30


