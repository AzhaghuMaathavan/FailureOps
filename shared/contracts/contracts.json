{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FailureOpsX_DataContracts",
  "description": "Standardized cross-tier contract definitions for Evidence, Signals, Failure DNA, Radar, and Interventions.",
  "definitions": {
    "PrivacyLevel": {
      "type": "string",
      "enum": ["PRIVATE", "ORGANIZATION", "GLOBAL_SANITIZED"]
    },
    "EvidenceItem": {
      "type": "object",
      "required": ["id", "projectId", "sourceId", "documentName", "evidenceType", "claim", "confidence", "visibility"],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "sourceId": { "type": "string" },
        "documentName": { "type": "string" },
        "pageOrSection": { "type": "string" },
        "evidenceType": { "type": "string", "enum": ["METRIC", "FACT", "QUOTE", "ANOMALY", "LOG", "OBSERVATION"] },
        "claim": { "type": "string" },
        "value": { "type": ["string", "number", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "visibility": { "$ref": "#/definitions/PrivacyLevel" }
      }
    },
    "Signal": {
      "type": "object",
      "required": ["id", "projectId", "name", "category", "severity", "confidence", "supportingEvidenceIds"],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "HEALTHY"] },
        "confidence": { "type": "number" },
        "supportingEvidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
