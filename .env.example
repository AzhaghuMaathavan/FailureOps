# FailureOps X — local foundation environment
# ===========================================
# Frontend (Next.js BFF on :3000) talks ONLY to the backend API.
# Backend (FastAPI RAG on :8000) talks to PostgreSQL + pgvector.
# Never prefix secrets with NEXT_PUBLIC_.
# Copy to .env (frontend BFF) and agentic-rag-main/.env (backend).

# --- Service URLs / ports ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
RAG_INTERNAL_URL=http://127.0.0.1:8000

# --- PostgreSQL + pgvector (Docker service: postgres) ---
# Host port 5432 maps to container 5432. Backend connects here when run on the host.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agentic_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agentic_rag

# Inside Docker, the RAG container must use the compose service hostname:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agentic_rag

# --- NVIDIA (existing project provider — do not invent keys) ---
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
EMBEDDING_API_KEY=
LLM_API_KEY=
NVIDIA_EMBED_API_KEY=
NVIDIA_PARSE_API_KEY=
NVIDIA_RERANK_API_KEY=
NVIDIA_LLM_API_KEY=
NVIDIA_LLM_API_KEY_1=
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_PARSE_MODEL=nvidia/nemotron-parse
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2

# --- Object storage (RustFS on the VPS; local filesystem is the offline fallback) ---
STORAGE_PROVIDER=rustfs
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=failureops
RUSTFS_SECRET_KEY=failureops_dev_secret_change_me
RUSTFS_BUCKET=failureops-documents
# Public console: https://storage.shyxon.com/rustfs/console/
# Public S3 API:  https://storage.shyxon.com

# --- Backend process ---
HOST=127.0.0.1
PORT=8000
APP_ENV=development

# --- Frontend BFF (no database client; these are server-only) ---
AUTH_SECRET=failureops_prod_secret_key_32_characters_minimum
SESSION_COOKIE_NAME=__Host-failureops-session
RATE_LIMIT_GENERAL=120
RATE_LIMIT_SEARCH=45
RATE_LIMIT_ANALYSIS=10
RATE_LIMIT_UPLOAD=15
