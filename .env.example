# FailureOps X Server Configuration
# ==================================
# Note: Sensitive secrets must be kept server-only. Do NOT prefix with NEXT_PUBLIC_.

# Backend / RAG FastAPI Internal URL
# Host: http://127.0.0.1:8000
# Docker: http://rag:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
RAG_INTERNAL_URL=http://127.0.0.1:8000

# Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://app_user:app_pass@127.0.0.1:5435/failureops_db

# Multi-Tenant & Session Security
AUTH_SECRET=failureops_prod_secret_key_32_characters_minimum
SESSION_COOKIE_NAME=__Host-failureops-session

# Rate Limiting Controls (Requests per 60 seconds)
RATE_LIMIT_GENERAL=120
RATE_LIMIT_SEARCH=45
RATE_LIMIT_ANALYSIS=10
RATE_LIMIT_UPLOAD=15
