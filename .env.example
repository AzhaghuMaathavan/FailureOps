# ==============================================================================
# FailureOps X — Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# - All variables listed here are SERVER-ONLY.
# - DO NOT prefix sensitive infrastructure variables with NEXT_PUBLIC_.
# - NEVER commit real keys, database credentials, or secret tokens to version control.
# ==============================================================================

# Private Backend-for-Frontend & RAG Services (Internal Network Only)
BACKEND_INTERNAL_URL=http://internal-backend.failureops.local:8080
RAG_INTERNAL_URL=http://internal-rag-service.failureops.local:8000
DATABASE_URL=postgresql://app_user:placeholder_password@internal-db.failureops.local:5432/failureops_enclave

# AI & LLM Model Credentials (Server-Side Only)
LLM_API_KEY=sk_live_placeholder_key_never_expose_to_client
LLM_API_ENDPOINT=https://api.openai.com/v1

# Cryptographic & Session Secrets (HttpOnly Session Security)
AUTH_SECRET=placeholder_32_byte_hex_secret_key_for_session_encryption
SESSION_COOKIE_NAME=__Host-failureops-session
ENCRYPTION_KEY=placeholder_aes_256_gcm_master_key

# Configurable Rate Limiting & Abuse Prevention (Requests per Minute per IP/User)
RATE_LIMIT_GENERAL=120
RATE_LIMIT_SEARCH=45
RATE_LIMIT_ANALYSIS=10
RATE_LIMIT_UPLOAD=15

# Security Environment Mode (development | staging | production)
NODE_ENV=development
